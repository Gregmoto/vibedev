{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vibedev",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "TICKET_ATTACHMENTS",
      "bucket_name": "vibedev-ticket-attachments"
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // Hyperdrive-config "vibedev-db" (Supabase session pooler, port 5432).
      "id": "1ccb5633c7d24e3d9a229116f9663aa8"
      // localConnectionString utelämnas medvetet: lokalt (next dev) faller appen tillbaka på
      // DATABASE_URL. För `wrangler dev`/`preview:cf` mot riktig DB, sätt env
      // WRANGLER_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE="<postgres-url>".
    }
  ]
}
