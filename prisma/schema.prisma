generator client {
  provider        = "prisma-client-js"
  // driverAdapters + INGEN output-katalog: OpenNext patchar den genererade klienten i
  // node_modules så att den kör på Cloudflare Workers (workerd) via @prisma/adapter-pg.
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  EDITOR
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  passwordHash  String?
  role          UserRole  @default(ADMIN)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model BlogPost {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  excerpt         String
  content         Json
  featuredImage   String?
  author          String?
  category        String
  tags            String[]
  status          ContentStatus @default(DRAFT)
  publishedAt     DateTime?
  seoTitle        String?
  metaDescription String?
  ogTitle         String?
  ogDescription   String?
  canonicalUrl    String?
  noindex         Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, publishedAt])
  @@index([category])
}

model PodcastEpisode {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  description     String
  showNotes       Json
  guestNames      String[]
  coverImage      String?
  audioUrl        String?
  embedUrl        String?
  status          ContentStatus @default(DRAFT)
  publishedAt     DateTime?
  seoTitle        String?
  metaDescription String?
  ogTitle         String?
  ogDescription   String?
  canonicalUrl    String?
  noindex         Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, publishedAt])
}

model CaseStudy {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  clientName      String?
  industry        String
  summary         String
  problem         String
  solution        String
  process         Json
  results         Json
  techStack       String[]
  featuredImage   String?
  status          ContentStatus @default(DRAFT)
  publishedAt     DateTime?
  seoTitle        String?
  metaDescription String?
  ogTitle         String?
  ogDescription   String?
  canonicalUrl    String?
  noindex         Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, publishedAt])
  @@index([industry])
}

model Page {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  intro           String?
  content         Json
  status          ContentStatus @default(DRAFT)
  seoTitle        String?
  metaDescription String?
  ogTitle         String?
  ogDescription   String?
  canonicalUrl    String?
  noindex         Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
}

model SiteSettings {
  id                              String   @id @default(cuid())
  siteName                        String   @default("VibeDev")
  siteUrl                         String   @default("https://vibedev.se")
  contactEmail                    String?
  phone                           String?
  address                         String?
  footerText                      String?
  socialLinks                     Json?
  defaultSeoTitle                 String?
  defaultMetaDescription          String?
  ga4MeasurementId                String?
  ga4CustomScript                 String?
  googleSearchConsoleVerification String?
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  message   String   @db.Text
  type      String // "contact" | "booking"
  metadata  Json? // extra fält för booking (projectType, budget, timeline osv.)
  status    String   @default("new") // "new" | "read" | "replied"
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([status])
  @@index([type])
}

model LeadMagnetSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String // "vibecoding-guide"
  confirmed Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([source])
}

// ── Ärendehantering (ticketsystem) ───────────────────────────────────────────

/// Ett konto motsvarar en inkorg: egen inbound-adress och egen svarsadress.
/// Flera konton kan finnas parallellt och hanteras från adminpanelen.
model TicketAccount {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  /// Adressen kunder mejlar, t.ex. "vibedev@inbound.vibedev.se"
  inboundEmail   String   @unique
  /// Avsändare för svar. Bör vara samma adress så att kundens svar kommer tillbaka hit.
  replyFromName  String
  replyFromEmail String
  /// Valfri påskrift som läggs sist i utgående svar
  signature      String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tickets Ticket[]

  @@index([isActive])
}

enum TicketStatus {
  OPEN
  PENDING
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

model Ticket {
  /// Löpnummer som visas för kunden, t.ex. #1042
  number    Int           @unique @default(autoincrement())
  id        String        @id @default(cuid())
  accountId String
  account   TicketAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  subject String
  status  TicketStatus @default(OPEN)

  customerEmail String
  customerName  String?
  /// Språk som upptäckts i kundens första mejl (ISO 639-1), styr autosvar
  language      String  @default("sv")

  /// Hemlig token för kundsidan — länken i mejlet är nyckeln
  publicToken String @unique

  /// Kort nyckel i svarsadressen, t.ex. "support+k3f9a2@inbound.vibedev.se".
  /// Medvetet skild från publicToken: svarsadressen syns i headers på varje
  /// vidarebefordrat mejl, och får därför inte vara nyckeln till kundportalen.
  replyKey String @unique

  /// null = oläst. Sätts när handläggaren markerar ärendet som läst, och
  /// nollställs igen så snart kunden skickar ett nytt meddelande.
  readAt DateTime?

  /// null = inte skräppost. Skräpärenden hålls utanför det vanliga flödet och
  /// utanför olästräknaren, men raderas inte — en felmarkering ska gå att ångra.
  /// Egen kolumn i stället för ett status-värde, så att ärendet behåller sitt
  /// öppet/väntande/avslutat om det tas tillbaka.
  spamAt DateTime?

  /// Senaste felet från autosvaret, t.ex. en avsändardomän som inte är
  /// verifierad. Sparas för att ett misslyckat autosvar annars bara syns i
  /// serverloggen — kunden får inget mejl och ingen märker det.
  autoReplyError String?

  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  messages TicketMessage[]

  @@index([accountId, status, lastMessageAt])
  @@index([customerEmail])
  @@index([readAt])
  @@index([spamAt])
}

model TicketMessage {
  id       String @id @default(cuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  direction MessageDirection
  fromEmail String
  fromName  String?
  bodyText  String
  bodyHtml  String?

  /// Resends id för inkommande mejl (hämtning av innehåll/bilagor) resp. utgående utskick
  resendEmailId   String?
  /// Message-ID från mejlet, används för trådning
  messageIdHeader String?

  createdAt DateTime @default(now())

  attachments TicketAttachment[]

  @@index([ticketId, createdAt])
  @@index([resendEmailId])
}

model TicketAttachment {
  id        String        @id @default(cuid())
  messageId String
  message   TicketMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  filename           String
  contentType        String
  sizeBytes          Int
  /// Antingen nyckel i egen lagring, eller Resends attachment-id för inkommande
  storageKey         String?
  resendAttachmentId String?

  createdAt DateTime @default(now())

  @@index([messageId])
}

// ── Bihr-katalog ─────────────────────────────────────────────────────────────

/// Logg över hämtningar från Bihr. Bara de 50 senaste sparas — äldre rader
/// säger inget som inte redan syns i filen som ligger i R2.
model BihrRun {
  id        String   @id @default(cuid())
  /// "nightly" eller "extended"
  kind      String
  /// true = lyckades
  success   Boolean
  /// Antal rader respektive antal märkesfiler, beroende på körningstyp
  rows      Int      @default(0)
  files     Int      @default(0)
  bytes     Int      @default(0)
  /// Hur lång tid körningen tog
  durationMs Int     @default(0)
  /// Felmeddelandet när körningen misslyckades
  error     String?
  /// Sattes körningen igång manuellt från adminpanelen?
  manual    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ── Uppladdade CSV-filer ─────────────────────────────────────────────────────

/// Fil som laddats upp i adminpanelen och delas via en fast länk.
/// Länken bygger på slug, som aldrig ändras — därför fortsätter den fungera
/// hos mottagaren även när filen byts ut mot en ny version.
model CsvFile {
  id          String   @id @default(cuid())
  /// Adressdelen. Sätts vid första uppladdningen och ändras aldrig.
  slug        String   @unique
  /// Visningsnamn, från filnamnet.
  name        String
  storageKey  String
  sizeBytes   Int      @default(0)
  contentType String   @default("text/csv")
  /// Antal gånger filen bytts ut.
  versions    Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([updatedAt])
}

// ── Inloggningsuppgifter till externa tjänster ───────────────────────────────

/// Uppgifter som anges i adminpanelen och används av bakgrundsjobb.
/// Lösenordet lagras alltid krypterat och skickas aldrig tillbaka till
/// webbläsaren — en läckt databasdump ska inte ge åtkomst till kundportaler.
model IntegrationCredential {
  id       String @id @default(cuid())
  /// "partseurope" osv.
  provider String @unique
  username String
  /// AES-GCM-krypterat lösenord, base64.
  secretCipher String
  /// Initieringsvektorn för krypteringen, base64. Unik per sparning.
  secretIv     String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}
